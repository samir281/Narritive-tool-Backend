# --- required in production ---
DATABASE_URL=jdbc:postgresql://HOST:5432/DBNAME?sslmode=require
DB_USER=
DB_PASSWORD=
# a long random string, at least 32 characters
JWT_SECRET=
# the website address (used in share links)
APP_BASE_URL=https://your-site.netlify.app
# websites allowed to call the API (comma-separated)
CORS_ORIGINS=https://your-site.netlify.app

# --- optional ---
# first admin, only created when the database has no admin yet
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=a-strong-password
# OCR needs ~600 MB RAM; set false on 512 MB hosts
OCR_ENABLED=true
# PORT is set by most hosts automatically
